{
  "name": "grand-transition",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "24.x",
    "npm": "12.x"
  },
  "scripts": {
    "dev": "vite",
    "prod": "npm run build && npm run preview -- --host 127.0.0.1 --strictPort",
    "preview": "vite preview",
    "build": "vite build",
    "assets:build": "node tools/validate-scaffold.mjs --domain assets --mode build",
    "assets:convert-green": "node .github/skills/repair-scene-composition/scripts/green-chroma-key.mjs convert-tree",
    "assets:validate": "node tools/validate-scaffold.mjs --domain assets && node .github/skills/repair-scene-composition/scripts/green-chroma-key.mjs validate src/assets",
    "content:validate": "node tools/validate-scaffold.mjs --domain content && vitest run --config vitest.config.ts tests/unit/content-schemas.test.ts",
    "localization:validate": "node tools/validate-scaffold.mjs --domain localization",
    "boundaries:check": "node tools/check-pure-boundaries.mjs",
    "simulate": "tsx tools/simulate.ts",
    "lint": "oxlint --type-aware --tsconfig tsconfig.json .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.browser.config.ts --coverage",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "markdown:lint": "markdownlint-cli2 \"README.md\" \"PRODUCT.md\" \"DESIGN.md\" \"docs/specs/**/*.md\" \".github/**/*.md\"",
    "validate": "npm run markdown:lint && npm run assets:validate && npm run content:validate && npm run localization:validate && npm run boundaries:check && npm run lint && npm run typecheck",
    "ci": "npm run validate && npm run test && npm run test:browser && npm run test:coverage && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource/poiret-one": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@lit/localize": "^0.12.2",
    "lit": "^3.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.9.0",
    "markdownlint-cli2": "^0.23.2",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
